<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        xmlns:views="using:OpenXLR.UI.Views"
        x:Class="OpenXLR.UI.BrowserTabsWindow"
        x:DataType="vm:MainViewModel"
        Title="{loc:Text Key=BrowserTabsTitle}" Width="620" SizeToContent="Height" MaxHeight="700" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Ox.Window.Background}" CanResize="False">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="14"/>
    </Style>
  </Window.Styles>

  <!-- Built like Manage apps: Close is docked to the bottom and the card above
       it takes what is left, so its tab list scrolls instead of pushing Close
       off a window that cannot be resized. -->
  <DockPanel Margin="14" LastChildFill="True">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
      <Button Name="BrowserTabsManual" Content="{loc:Text Key=Manual}" Padding="18,6" Click="OnManual"
              ToolTip.Tip="{loc:Text Key=BrowserTabsGuideHint}"/>
      <Button Grid.Column="2" Content="{loc:Text Key=Close}" Padding="18,6" Click="OnClose"/>
    </Grid>
    <Border Classes="card">
      <views:BrowserTabsView/>
    </Border>
  </DockPanel>
</Window>
