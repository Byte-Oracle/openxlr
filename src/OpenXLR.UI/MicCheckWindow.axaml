<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        xmlns:skin="using:OpenXLR.UI.Skinning"
        x:Class="OpenXLR.UI.MicCheckWindow" x:DataType="vm:MicCheckViewModel"
        Title="{loc:Text Key=MicCheck}" Width="640" Height="640" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ox.Window.Background}">
  <!-- Mic check for one microphone, one step at a time: where the microphone
       goes, the level before any processing, a take heard raw and processed,
       then the EQ, filters, plugins and presets that shape it. Every colour,
       size and radius is an Ox.* token or a control theme; the waveform and
       the embedded EQ graph draw with the EQ editor's colours. -->
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="{loc:Text Key=MicCheck}" Classes="title" Margin="0,0,0,8"/>

    <!-- the steps, free to jump between: the lit one is shown -->
    <ItemsControl DockPanel.Dock="Top" Name="MicCheckSteps" ItemsSource="{Binding Steps}" Margin="0,0,0,12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="6" LineSpacing="4"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MicCheckStepItem">
          <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnStep" Padding="14,5"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- what the session reports, the daemon's refusal, and closing -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
      <TextBlock Name="MicCheckError" Text="{Binding Error}" TextWrapping="Wrap" Classes="warn"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{loc:Text Key=MicCheckClosingDiscards}" Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Name="MicCheckClose" Content="{loc:Text Key=Close}" Padding="18,6" Click="OnClose" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Panel Margin="0,0,16,0">
        <!-- Position: tips for the unit the microphone is on, and its phantom power -->
        <StackPanel Name="MicCheckPosition" Spacing="12" IsVisible="{Binding ShowsPosition}">
          <TextBlock Name="MicCheckPositionIntro" Text="{Binding PositionIntro}" Classes="body" TextWrapping="Wrap"/>
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicCheckPlacement}" Classes="h"/>
              <ItemsControl Name="MicCheckTips" ItemsSource="{Binding PositionTips}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" Classes="body" TextWrapping="Wrap"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- phantom power, where the microphone is not the unit's own capsule -->
          <Border Classes="tile" Padding="12" Name="MicCheckPhantomTile" IsVisible="{Binding ShowsPhantom}">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicCheckPhantomPower}" Classes="h"/>
              <TextBlock Text="{loc:Text Key=MicCheckPhantomHint}" Classes="hint" TextWrapping="Wrap"/>
              <WrapPanel Name="MicCheckPhantom" ItemSpacing="8" LineSpacing="4" IsVisible="{Binding HasPhantom}">
                <ToggleButton Name="MicCheckUnitPhantom" Content="{loc:Text Key=Phantom}"
                              IsChecked="{Binding Unit.Phantom, Mode=TwoWay, FallbackValue=False}" IsVisible="{Binding Unit.CapPhantom, FallbackValue=False}"
                              AutomationProperties.Name="{loc:Text Key=MicCheckPhantomName}" ToolTip.Tip="{loc:Text Key=MicCheckPhantomName}"/>
                <ToggleButton Name="MicCheckExtraPhantom" Content="{loc:Text Key=Phantom}"
                              IsChecked="{Binding ExtraUnit.Phantom, Mode=TwoWay, FallbackValue=False}" IsVisible="{Binding ExtraUnit.HasPhantom, FallbackValue=False}"
                              IsEnabled="{Binding ExtraUnit.CanControl, FallbackValue=False}"
                              AutomationProperties.Name="{loc:Text Key=MicCheckPhantomName}" ToolTip.Tip="{loc:Text Key=MicCheckPhantomName}"/>
                <TextBlock Text="{loc:Text Key=PhantomPowerSettling}" Classes="hint" VerticalAlignment="Center"
                           IsVisible="{Binding Unit.PhantomSettling, FallbackValue=False}"/>
                <TextBlock Text="{loc:Text Key=PhantomPowerSettling}" Classes="hint" VerticalAlignment="Center"
                           IsVisible="{Binding ExtraUnit.PhantomSettling, FallbackValue=False}"/>
              </WrapPanel>
              <TextBlock Name="MicCheckPhantomElsewhere" Text="{loc:Text Key=MicCheckPhantomElsewhere}" Classes="hint" TextWrapping="Wrap"
                         IsVisible="{Binding PhantomElsewhere}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Level: the microphone before any processing, the target band and the clip light -->
        <StackPanel Name="MicCheckLevel" Spacing="12" IsVisible="{Binding ShowsLevel}">
          <TextBlock Text="{loc:Text Key=MicCheckLevelHint}" Classes="hint" TextWrapping="Wrap"/>
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{loc:Text Key=MicCheckBeforeEffects}" Classes="h" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Name="MicCheckPeakValue" Text="{Binding PeakText}" Classes="val" VerticalAlignment="Center"/>
              </Grid>
              <!-- the meter, with the band speech should peak in drawn under it: -18 to -6 dBFS on a -60 to 0 scale -->
              <Grid RowDefinitions="Auto,Auto">
                <skin:LevelMeter Name="MicCheckMeter" Level="{Binding InputPeak}" Height="22"
                                 AutomationProperties.Name="{loc:Text Key=MicCheckBeforeEffects}"/>
                <Grid Grid.Row="1" ColumnDefinitions="7*,2*,1*" Margin="0,3,0,0">
                  <Border Grid.Column="1" Name="MicCheckTarget" Height="6" Background="{DynamicResource Ox.Eq.CurveFill}"
                          BorderBrush="{DynamicResource Ox.Eq.Curve}" BorderThickness="1"
                          CornerRadius="{DynamicResource Ox.Meter.CornerRadius}" ToolTip.Tip="{loc:Text Key=MicCheckTargetTip}"/>
                </Grid>
              </Grid>
              <skin:LevelMeter Name="MicCheckRms" Level="{Binding InputLevel}" AutomationProperties.Name="{loc:Text Key=MicCheckAverage}"
                               ToolTip.Tip="{loc:Text Key=MicCheckAverage}"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{loc:Text Key=MicCheckTargetTip}" Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <!-- the clip light holds until it is pressed -->
                <Button Grid.Column="1" Name="MicCheckClip" Click="OnClearClip" Padding="10,4"
                        AutomationProperties.Name="{Binding ClipName}" ToolTip.Tip="{loc:Text Key=MicCheckClipTip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <skin:StatusLed IsOn="{Binding Clipped}" Kind="Power"/>
                    <TextBlock Text="{loc:Text Key=MicCheckClip}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>
          <!-- the interface's gain, where the channel carries an input that has one -->
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicCheckGain}" Classes="h"/>
              <Grid ColumnDefinitions="*,64" ColumnSpacing="8" IsVisible="{Binding CarriesUnit}">
                <Slider Name="MicCheckUnitGain" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding Unit.GainMaxDb, FallbackValue=80}"
                        Value="{Binding Unit.GainDb, Mode=TwoWay, FallbackValue=0}" IsEnabled="{Binding !Unit.GainLocked, FallbackValue=False}"
                        AutomationProperties.Name="{Binding Unit.GainName, FallbackValue=''}"/>
                <TextBlock Grid.Column="1" Text="{Binding Unit.GainText, FallbackValue=''}" Classes="val" VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="*,64" ColumnSpacing="8" IsVisible="{Binding CarriesExtraUnit}">
                <Slider Name="MicCheckExtraGain" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding ExtraUnit.GainMaxDb, FallbackValue=80}"
                        Value="{Binding ExtraUnit.GainDb, Mode=TwoWay, FallbackValue=0}" IsEnabled="{Binding ExtraUnit.CanAdjustGain, FallbackValue=False}"
                        AutomationProperties.Name="{Binding ExtraUnit.GainName, FallbackValue=''}"/>
                <TextBlock Grid.Column="1" Text="{Binding ExtraUnit.GainText, FallbackValue=''}" Classes="val" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Name="MicCheckNoGain" Text="{loc:Text Key=MicCheckNoGain}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding NoGain}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Listen: a take, its waveform, raw and processed, and hearing yourself -->
        <StackPanel Name="MicCheckListen" Spacing="12" IsVisible="{Binding ShowsListen}">
          <TextBlock Text="{loc:Text Key=MicCheckListenHint}" Classes="hint" TextWrapping="Wrap"/>
          <TextBlock Name="MicCheckStatus" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Ox.Text.Primary}"/>
          <WrapPanel Name="MicCheckActions" ItemSpacing="8" LineSpacing="8">
            <Button Content="{loc:Text Key=Record}" IsEnabled="{Binding CanRecord}" Click="OnRecord"/>
            <Button Content="{loc:Text Key=MicCheckLoopTake}" IsEnabled="{Binding CanLoop}" Click="OnLoop"/>
            <Button Content="{loc:Text Key=MicCheckLiveMic}" IsEnabled="{Binding CanLive}" Click="OnLive"/>
            <Button Content="{loc:Text Key=StopAndDiscard}" IsEnabled="{Binding CanStop}" Click="OnStop"/>
          </WrapPanel>
          <vm:TakeWaveform Name="MicCheckWaveform" Height="96" Peaks="{Binding Peaks}" Position="{Binding Position}"
                           CornerRadius="{DynamicResource Ox.Eq.CornerRadius}" AutomationProperties.Name="{loc:Text Key=MicCheckWaveform}"/>
          <TextBlock Text="{loc:Text Key=MicCheckNoTake}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !HasTake}"/>

          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <!-- two sides of one switch: the lit side is the daemon's, a press asks for its side -->
              <WrapPanel Name="MicCheckCompare" ItemSpacing="6" LineSpacing="4" IsEnabled="{Binding CanSwitch}">
                <TextBlock Text="{loc:Text Key=MicCheckCompare}" Classes="h" VerticalAlignment="Center"/>
                <ToggleButton Name="MicCheckProcessed" Content="{loc:Text Key=MicCheckProcessed}" IsChecked="{Binding ListenProcessed, Mode=OneWay}"
                              Click="OnProcessed"/>
                <ToggleButton Name="MicCheckRaw" Content="{loc:Text Key=MicCheckRaw}" IsChecked="{Binding ListenRaw, Mode=OneWay}"
                              Click="OnRaw"/>
              </WrapPanel>
              <TextBlock Text="{loc:Text Key=MicCheckCompareHint}" Classes="hint" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <CheckBox Name="MicCheckHearMyself" IsChecked="{Binding HearMyself, Mode=OneWay}" IsEnabled="{Binding CanSwitch}" Click="OnHearMyself">
                <TextBlock Text="{loc:Text Key=MicCheckHearMyself}" TextWrapping="Wrap"/>
              </CheckBox>
              <TextBlock Name="MicCheckLatency" Text="{Binding LatencyText}" Classes="hint" TextWrapping="Wrap"/>
              <TextBlock Text="{loc:Text Key=MicCheckProDirect}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding ProDirect}"/>
              <TextBlock Name="MicCheckNotHeard" Text="{loc:Text Key=MicCheckNotHeard}" Classes="warn" TextWrapping="Wrap" IsVisible="{Binding NotHeard}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Shape: presets, the EQ curve, low cut and ClipGuard, and the plugins, all heard live -->
        <StackPanel Name="MicCheckShape" Spacing="12" IsVisible="{Binding ShowsShape}">
          <TextBlock Text="{loc:Text Key=MicCheckShapeHint}" Classes="hint" TextWrapping="Wrap"/>

          <!-- starting presets: each one is one EQ change, and the last can be undone -->
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicCheckPresets}" Classes="h"/>
              <ItemsControl Name="MicCheckPresetList" ItemsSource="{Binding Presets}" IsEnabled="{Binding CanApplyPreset}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MicCheckPreset">
                    <Button Content="{Binding Name}" Click="OnPreset" Padding="14,5" ToolTip.Tip="{Binding Hint}"
                            AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Hint}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Name="MicCheckPresetStatus" Text="{Binding PresetStatus}" Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="MicCheckUndoPreset" Content="{loc:Text Key=MicCheckUndoPreset}" IsEnabled="{Binding CanUndoPreset}"
                        Click="OnUndoPreset" VerticalAlignment="Center" ToolTip.Tip="{loc:Text Key=MicCheckUndoPresetTip}"
                        AutomationProperties.Name="{loc:Text Key=MicCheckUndoPreset}" AutomationProperties.HelpText="{loc:Text Key=MicCheckUndoPresetTip}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- the microphone EQ: the editor's own graph on the channel's own model -->
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{loc:Text Key=MicCheckEq}" Classes="h" VerticalAlignment="Center"/>
                <WrapPanel Grid.Column="1" Name="MicCheckEqActions" ItemSpacing="6" LineSpacing="4" IsVisible="{Binding HasEq}">
                  <ToggleButton Name="MicCheckEqSwitch" Content="{loc:Text Key=EqSwitch}" IsChecked="{Binding Eq.Enabled, Mode=TwoWay, FallbackValue=False}"
                                AutomationProperties.Name="{Binding Eq.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=EqSwitchTip}"/>
                  <Button Name="MicCheckEqEditor" Content="{loc:Text Key=MicCheckEqEditor}" Click="OnEqEditor"
                          AutomationProperties.Name="{loc:Text Key=MicCheckEqEditorTip}" ToolTip.Tip="{loc:Text Key=MicCheckEqEditorTip}"/>
                </WrapPanel>
              </Grid>
              <Panel IsVisible="{Binding HasEq}">
                <vm:EqGraph Name="MicCheckEqGraph" DataContext="{Binding Eq}" Height="180"
                            CurveThickness="{DynamicResource Ox.Eq.CurveThickness}" BandCurveThickness="{DynamicResource Ox.Eq.BandCurveThickness}"
                            HandleSize="{DynamicResource Ox.Eq.HandleSize}" LabelFontSize="{DynamicResource Ox.Eq.LabelFontSize}"
                            CornerRadius="{DynamicResource Ox.Eq.CornerRadius}" MinimumTarget="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            AutomationProperties.Name="{loc:Text Key=EqGraphName}"/>
              </Panel>
              <TextBlock Name="MicCheckEqStatus" Text="{Binding Eq.Status, FallbackValue=''}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasEq}"/>
              <TextBlock Name="MicCheckNoEq" Text="{loc:Text Key=MicCheckNoEq}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding NoEq}"/>
            </StackPanel>
          </Border>

          <!-- low cut and ClipGuard: the unit's, before the take, and XLR 1's software ones, after the EQ -->
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicCheckFilters}" Classes="h"/>
              <WrapPanel Name="MicCheckUnitFilters" ItemSpacing="6" LineSpacing="4" IsVisible="{Binding HasUnitFilters}">
                <ToggleButton Content="{loc:Text Key=LowCut}" IsChecked="{Binding Unit.LowCut, Mode=TwoWay, FallbackValue=False}"
                              IsVisible="{Binding Unit.CapLowCut, FallbackValue=False}" AutomationProperties.Name="{loc:Text Key=MicCheckUnitLowCut}"
                              ToolTip.Tip="{loc:Text Key=MicCheckUnitLowCut}"/>
                <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding Unit.ClipGuard, Mode=TwoWay, FallbackValue=False}"
                              IsVisible="{Binding Unit.CapClipGuard, FallbackValue=False}" AutomationProperties.Name="{loc:Text Key=MicCheckUnitClipGuard}"
                              ToolTip.Tip="{loc:Text Key=MicCheckUnitClipGuard}"/>
                <ToggleButton Content="{loc:Text Key=LowCut}" IsChecked="{Binding ExtraUnit.LowCut, Mode=TwoWay, FallbackValue=False}"
                              IsVisible="{Binding ExtraUnit.HasLowCut, FallbackValue=False}" IsEnabled="{Binding ExtraUnit.CanControl, FallbackValue=False}"
                              AutomationProperties.Name="{loc:Text Key=MicCheckUnitLowCut}" ToolTip.Tip="{loc:Text Key=MicCheckUnitLowCut}"/>
                <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding ExtraUnit.ClipGuard, Mode=TwoWay, FallbackValue=False}"
                              IsVisible="{Binding ExtraUnit.HasClipGuard, FallbackValue=False}" IsEnabled="{Binding ExtraUnit.CanControl, FallbackValue=False}"
                              AutomationProperties.Name="{loc:Text Key=MicCheckUnitClipGuard}" ToolTip.Tip="{loc:Text Key=MicCheckUnitClipGuard}"/>
              </WrapPanel>
              <TextBlock Text="{loc:Text Key=MicCheckUnitFiltersHint}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasUnitFilters}"/>
              <WrapPanel Name="MicCheckSoftwareFilters" ItemSpacing="6" LineSpacing="4" IsVisible="{Binding HasSoftwareFilters}">
                <ToggleButton Content="{Binding Software.SoftLowCutText, FallbackValue=''}" IsVisible="{Binding Software.ShowSoftLowCut, FallbackValue=False}"
                              IsChecked="{Binding Software.SoftLowCutOn, Mode=OneWay, FallbackValue=False}" Click="OnCycleSoftLowCut"
                              AutomationProperties.Name="{loc:Text Key=MicCheckSoftwareLowCut}" ToolTip.Tip="{loc:Text Key=HostSideLowCutForThisDeviceIts}"/>
                <ToggleButton Content="{loc:Text Key=ClipGuard}" IsVisible="{Binding Software.ShowSoftClipGuard, FallbackValue=False}"
                              IsChecked="{Binding Software.SoftClipGuard, Mode=TwoWay, FallbackValue=False}"
                              IsEnabled="{Binding Software.SoftClipGuardAvailable, FallbackValue=False}"
                              AutomationProperties.Name="{loc:Text Key=MicCheckSoftwareClipGuard}" ToolTip.Tip="{Binding Software.SoftClipGuardTip, FallbackValue=''}"/>
              </WrapPanel>
              <TextBlock Text="{loc:Text Key=MicCheckSoftwareFiltersHint}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasSoftwareFilters}"/>
              <TextBlock Name="MicCheckNoFilters" Text="{loc:Text Key=MicCheckNoFilters}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding NoFilters}"/>
            </StackPanel>
          </Border>

          <!-- the channel's plugins: bypass, the editor and add effect; the chain window does the rest -->
          <Border Classes="tile" Padding="12" IsVisible="{Binding Chain, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8" IsEnabled="{Binding Chain.CanEditEffects, FallbackValue=False}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{loc:Text Key=MicCheckEffects}" Classes="h" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="MicCheckAddEffect" Content="{loc:Text Key=MicCheckAddEffect}" Click="OnAddEffect"
                        AutomationProperties.Name="{loc:Text Key=MicCheckAddEffect}" ToolTip.Tip="{loc:Text Key=MicCheckAddEffectTip}"/>
              </Grid>
              <TextBlock Name="MicCheckNoEffects" Text="{loc:Text Key=NoInsertsYet}" Classes="hint" TextWrapping="Wrap"
                         IsVisible="{Binding !Chain.HasItems, FallbackValue=False}"/>
              <ItemsControl Name="MicCheckInserts" ItemsSource="{Binding Chain.Items, FallbackValue={x:Null}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InsertViewModel">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <skin:StatusLed IsOn="{Binding IsActive}" Kind="Insert" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding StateText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="body" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" ToolTip.Tip="{Binding Label}"/>
                        <ToggleButton Grid.Column="2" Name="MicCheckBypass" Content="{loc:Text Key=Bypass}" IsChecked="{Binding Bypass, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Label, StringFormat={loc:Text Key=MicCheckBypassName}}"/>
                        <Button Grid.Column="3" Name="MicCheckInsertEditor" Content="{loc:Text Key=MicCheckEditor}" Click="OnInsertEditor"
                                ToolTip.Tip="{Binding ControlsHint}"
                                AutomationProperties.Name="{Binding Label, StringFormat={loc:Text Key=MicCheckEditorName}}"/>
                      </Grid>
                      <TextBlock Text="{Binding Error}" Classes="warn" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{loc:Text Key=MicCheckEffectsHint}" Classes="hint" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </DockPanel>
</Window>
