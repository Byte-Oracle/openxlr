<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        xmlns:skin="using:OpenXLR.UI.Skinning"
        x:Class="OpenXLR.UI.MicCheckWindow" x:DataType="vm:MicCheckViewModel"
        Title="{loc:Text Key=MicCheck}" Width="600" Height="560" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ox.Window.Background}">
  <!-- Mic check for one microphone, one step at a time: the level before any
       processing, then a take heard raw and processed. Every colour, size and
       radius is an Ox.* token or a control theme; the waveform draws with the
       EQ graph's colours. -->
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="{loc:Text Key=MicCheck}" Classes="title" Margin="0,0,0,8"/>

    <!-- the steps, free to jump between: the lit one is shown -->
    <ItemsControl DockPanel.Dock="Top" Name="MicCheckSteps" ItemsSource="{Binding Steps}" Margin="0,0,0,12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="6" LineSpacing="4"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MicCheckStepItem">
          <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnStep" Padding="14,5"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- what the session reports, the daemon's refusal, and closing -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
      <TextBlock Name="MicCheckError" Text="{Binding Error}" TextWrapping="Wrap" Classes="warn"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{loc:Text Key=MicCheckClosingDiscards}" Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Name="MicCheckClose" Content="{loc:Text Key=Close}" Padding="18,6" Click="OnClose" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Panel Margin="0,0,16,0">
        <!-- Level: the microphone before any processing, the target band and the clip light -->
        <StackPanel Name="MicCheckLevel" Spacing="12" IsVisible="{Binding ShowsLevel}">
          <TextBlock Text="{loc:Text Key=MicCheckLevelHint}" Classes="hint" TextWrapping="Wrap"/>
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{loc:Text Key=MicCheckBeforeEffects}" Classes="h" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Name="MicCheckPeakValue" Text="{Binding PeakText}" Classes="val" VerticalAlignment="Center"/>
              </Grid>
              <!-- the meter, with the band speech should peak in drawn under it: -18 to -6 dBFS on a -60 to 0 scale -->
              <Grid RowDefinitions="Auto,Auto">
                <skin:LevelMeter Name="MicCheckMeter" Level="{Binding InputPeak}" Height="22"
                                 AutomationProperties.Name="{loc:Text Key=MicCheckBeforeEffects}"/>
                <Grid Grid.Row="1" ColumnDefinitions="7*,2*,1*" Margin="0,3,0,0">
                  <Border Grid.Column="1" Name="MicCheckTarget" Height="6" Background="{DynamicResource Ox.Eq.CurveFill}"
                          BorderBrush="{DynamicResource Ox.Eq.Curve}" BorderThickness="1"
                          CornerRadius="{DynamicResource Ox.Meter.CornerRadius}" ToolTip.Tip="{loc:Text Key=MicCheckTargetTip}"/>
                </Grid>
              </Grid>
              <skin:LevelMeter Name="MicCheckRms" Level="{Binding InputLevel}" AutomationProperties.Name="{loc:Text Key=MicCheckAverage}"
                               ToolTip.Tip="{loc:Text Key=MicCheckAverage}"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{loc:Text Key=MicCheckTargetTip}" Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <!-- the clip light holds until it is pressed -->
                <Button Grid.Column="1" Name="MicCheckClip" Click="OnClearClip" Padding="10,4"
                        AutomationProperties.Name="{Binding ClipName}" ToolTip.Tip="{loc:Text Key=MicCheckClipTip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <skin:StatusLed IsOn="{Binding Clipped}" Kind="Power"/>
                    <TextBlock Text="{loc:Text Key=MicCheckClip}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>
          <!-- the interface's gain, where the channel carries an input that has one -->
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicCheckGain}" Classes="h"/>
              <Grid ColumnDefinitions="*,64" ColumnSpacing="8" IsVisible="{Binding CarriesUnit}">
                <Slider Name="MicCheckUnitGain" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding Unit.GainMaxDb, FallbackValue=80}"
                        Value="{Binding Unit.GainDb, Mode=TwoWay, FallbackValue=0}" IsEnabled="{Binding !Unit.GainLocked, FallbackValue=False}"
                        AutomationProperties.Name="{Binding Unit.GainName, FallbackValue=''}"/>
                <TextBlock Grid.Column="1" Text="{Binding Unit.GainText, FallbackValue=''}" Classes="val" VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="*,64" ColumnSpacing="8" IsVisible="{Binding CarriesExtraUnit}">
                <Slider Name="MicCheckExtraGain" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding ExtraUnit.GainMaxDb, FallbackValue=80}"
                        Value="{Binding ExtraUnit.GainDb, Mode=TwoWay, FallbackValue=0}" IsEnabled="{Binding ExtraUnit.CanAdjustGain, FallbackValue=False}"
                        AutomationProperties.Name="{Binding ExtraUnit.GainName, FallbackValue=''}"/>
                <TextBlock Grid.Column="1" Text="{Binding ExtraUnit.GainText, FallbackValue=''}" Classes="val" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Name="MicCheckNoGain" Text="{loc:Text Key=MicCheckNoGain}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding NoGain}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Listen: a take, its waveform, raw and processed, and hearing yourself -->
        <StackPanel Name="MicCheckListen" Spacing="12" IsVisible="{Binding ShowsListen}">
          <TextBlock Text="{loc:Text Key=MicCheckListenHint}" Classes="hint" TextWrapping="Wrap"/>
          <TextBlock Name="MicCheckStatus" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Ox.Text.Primary}"/>
          <WrapPanel Name="MicCheckActions" ItemSpacing="8" LineSpacing="8">
            <Button Content="{loc:Text Key=Record}" IsEnabled="{Binding CanRecord}" Click="OnRecord"/>
            <Button Content="{loc:Text Key=MicCheckLoopTake}" IsEnabled="{Binding CanLoop}" Click="OnLoop"/>
            <Button Content="{loc:Text Key=MicCheckLiveMic}" IsEnabled="{Binding CanLive}" Click="OnLive"/>
            <Button Content="{loc:Text Key=StopAndDiscard}" IsEnabled="{Binding CanStop}" Click="OnStop"/>
          </WrapPanel>
          <vm:TakeWaveform Name="MicCheckWaveform" Height="96" Peaks="{Binding Peaks}" Position="{Binding Position}"
                           CornerRadius="{DynamicResource Ox.Eq.CornerRadius}" AutomationProperties.Name="{loc:Text Key=MicCheckWaveform}"/>
          <TextBlock Text="{loc:Text Key=MicCheckNoTake}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !HasTake}"/>

          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <!-- two sides of one switch: the lit side is the daemon's, a press asks for its side -->
              <WrapPanel Name="MicCheckCompare" ItemSpacing="6" LineSpacing="4" IsEnabled="{Binding CanSwitch}">
                <TextBlock Text="{loc:Text Key=MicCheckCompare}" Classes="h" VerticalAlignment="Center"/>
                <ToggleButton Name="MicCheckProcessed" Content="{loc:Text Key=MicCheckProcessed}" IsChecked="{Binding ListenProcessed, Mode=OneWay}"
                              Click="OnProcessed"/>
                <ToggleButton Name="MicCheckRaw" Content="{loc:Text Key=MicCheckRaw}" IsChecked="{Binding ListenRaw, Mode=OneWay}"
                              Click="OnRaw"/>
              </WrapPanel>
              <TextBlock Text="{loc:Text Key=MicCheckCompareHint}" Classes="hint" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <CheckBox Name="MicCheckHearMyself" IsChecked="{Binding HearMyself, Mode=OneWay}" IsEnabled="{Binding CanSwitch}" Click="OnHearMyself">
                <TextBlock Text="{loc:Text Key=MicCheckHearMyself}" TextWrapping="Wrap"/>
              </CheckBox>
              <TextBlock Name="MicCheckLatency" Text="{Binding LatencyText}" Classes="hint" TextWrapping="Wrap"/>
              <TextBlock Text="{loc:Text Key=MicCheckProDirect}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding ProDirect}"/>
              <TextBlock Name="MicCheckNotHeard" Text="{loc:Text Key=MicCheckNotHeard}" Classes="warn" TextWrapping="Wrap" IsVisible="{Binding NotHeard}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </DockPanel>
</Window>
