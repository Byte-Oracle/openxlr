      "type": "linear",
      "from": [0, 0],
      "to": [0, 1],
      "stops": [
        { "offset": 0, "color": "#14e8ebef" },
        { "offset": 0.45, "color": "#00e8ebef" },
        { "offset": 1, "color": "#1c08090b" }
      ]
    },
    "Ox.Led.Bezel": "#08090b",
    "Ox.Led.BezelThickness": 1,
    "Ox.Led.Glow": 0.3,
    "Ox.Led.CoreScale": 0.6
  },
  "layout": {
    "version": 1,
    "main": {
      "kind": "stack",
      "id": "desk",
      "orientation": "vertical",
      "spacing": 12,
      "children": [
        {
          "kind": "dock",
          "id": "console",
          "spacing": 12,
          "children": [
            {
              "kind": "stack",
              "id": "rack-column",
              "orientation": "vertical",
              "spacing": 12,
              "dock": "left",
              "children": [
                { "kind": "region", "region": "inputs" },
                { "kind": "region", "region": "applications" }
              ]
            },
            {
              "kind": "stack",
              "id": "mix-column",
              "orientation": "vertical",
              "spacing": 12,
              "dock": "fill",
              "children": [
                { "kind": "region", "region": "submixer" },
                { "kind": "region", "region": "monitor" }
              ]
            }
          ]
        },
        { "kind": "region", "region": "headphones" }
      ]
    },
    "regions": {
      "header": {
        "actions": ["profiles", "flow", "arrange"],
        "overflow": ["restart-daemon", "about"]
      },
      "inputs": {
        "template": "input-rack",
        "strip": {
          "template": "input-row",
          "partsOrder": ["identity", "meter", "gain", "hardware-controls", "effects"],
          "label": { "style": "icon-and-text" },
          "meter": { "orientation": "horizontal", "placement": "below-label" }
        }
      },
      "applications": { "template": "application-list" },
      "submixer": {
        "template": "mix-banks",
        "orientation": "horizontal",
        "visibleBanks": 2,
        "selectionDefaults": ["monitor", "stream"],
        "strip": {
          "template": "vertical-strip",
          "partsOrder": ["identity", "meter", "fader", "value", "mute"],
          "label": { "style": "text" },
          "fader": { "orientation": "vertical", "direction": "normal" },
          "meter": { "orientation": "vertical", "placement": "beside-fader" }
        },
        "master": { "template": "master-strip" },
        "popOut": { "default": "docked" }
      },
      "monitor": { "template": "output-toolbar" },
      "headphones": { "visibility": "collapsed" }
    }
  }
}
