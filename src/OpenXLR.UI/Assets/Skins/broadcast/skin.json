{
  "$schema": "https://raw.githubusercontent.com/emaspa/openxlr/main/docs/skin.schema.json",
  "schema": 1,
  "id": "broadcast",
  "name": "Broadcast",
  "description": "A rack of inputs down the left, Monitor A and Stream as two banks of upright faders beside it and the monitor output under them, on a dark console palette",
  "author": "OpenXLR",
  "controls": {
    "button": "cap",
    "fader": "console",
    "meter": "segmented",
    "led": "lamp",
    "mute": "cap"
  },
