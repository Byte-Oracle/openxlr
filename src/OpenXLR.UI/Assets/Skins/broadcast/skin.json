    "Ox.Text.Info": "#6cb6f2",
    "Ox.Link.Foreground": "#6cb6f2",
    "Ox.Link.ForegroundPointerOver": "#9ccdf7",
    "Ox.Font.Family": "sans-serif",
    "Ox.Led.On": "#3ddc84",
    "Ox.Led.Off": "#3a4049",
    "Ox.Led.Alert": "#ff5f5f",
    "Ox.Led.Size": 12,
