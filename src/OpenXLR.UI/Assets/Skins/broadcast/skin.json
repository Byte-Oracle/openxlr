    "Ox.Mute.BorderBrush": "#3a414b",
    "Ox.Mute.BorderThickness": 1,
    "Ox.Fader.Track": "#0a0b0d",
    "Ox.Fader.Fill": "#4c9be8",
    "Ox.Fader.TrackHeight": 4,
    "Ox.Fader.TrackCornerRadius": 2,
    "Ox.Fader.Thumb.Background": "#d9dde3",
    "Ox.Fader.Thumb.BorderBrush": "#5b6470",
    "Ox.Fader.Thumb.BorderThickness": 1,
    "Ox.Fader.Thumb.Width": 26,
    "Ox.Fader.Thumb.Height": 14,
    "Ox.Fader.Thumb.CornerRadius": 2,
    "Ox.Fader.Thumb.Grip": "#0f1114",
    "Ox.Fader.Thumb.GripLength": 12,
    "Ox.Control.Background": "#22272e",
    "Ox.Control.BackgroundPointerOver": "#2a3038",
