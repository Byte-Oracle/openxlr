{
  "manifest_version": 3,
  "name": "OpenXLR browser routing",
  "version": "0.1.0",
  "description": "Choose an OpenXLR channel for each browser tab. Requires the OpenXLR native application.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "storage",
    "nativeMessaging"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Route this tab with OpenXLR"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "Open the channel picker for this tab"
    }
  }
}
